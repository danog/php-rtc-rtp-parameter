{
    "name": "danog/php-rtc-rtp-parameter",
    "type": "library",
    "description": "RTP codec, payload, SSRC, header-extension, and RTCP parameter objects. MadelineProto's PHP 8.2+ fork supports the modular danog/php-rtc stack.",
    "keywords": [
        "webrtc",
        "rtp-parameter",
        "rtp"
    ],
    "homepage": "https://github.com/danog/php-rtc-rtp-parameter",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "danog/php-rtc-mixin": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\RTPParameter\\": "src"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "*"
    }
}
